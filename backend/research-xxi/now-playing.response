                    "title": "AIUEO MACAM BETOOL AJA",
                    "duration": 120,
                    "genre": "Comedy, Romance",
                    "age_limit": 18,
                    "rating": "D17+",
                    "movie_type": "2D",
                    "distributor": "33b0b1d6-6c68-4d6b-9fbb-18a72775b39e",
                    "producer": "Cing Kyatt, Michel Khatwani, Teezar Sjamsuddin",
