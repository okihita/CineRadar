# ==============================================================================
# CineRadar — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to:
#   - ./.env                (for Python scraping engine & CLI tools)
#   - ./admin/.env.local     (for Next.js Studio Admin dashboard)
#   - ./web/.env.local       (for Consumer Web application)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Scraping Engine & TIX ID Credentials (Used by Python Backend)
# ------------------------------------------------------------------------------
TIX_PHONE_NUMBER="+6281234567890"
TIX_PASSWORD="your_tix_password"
YOUTUBE_API_KEY="your_youtube_data_api_v3_key"

# ------------------------------------------------------------------------------
# 2. Firebase Client SDK (Used by admin/ and web/ frontend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="cineradar-prod"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="cineradar-prod.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef"

# ------------------------------------------------------------------------------
# 3. Google Maps SDK (Used by admin/ theatre coverage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 4. Firebase Admin SDK / Service Account (Used by admin/ Next.js API routes)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="cineradar-prod"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@cineradar-prod.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 5. Studio Authentication (NextAuth v5 & Google OAuth)
# ------------------------------------------------------------------------------
AUTH_SECRET="generate_with_openssl_rand_base64_32"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your_google_oauth_secret"

# ------------------------------------------------------------------------------
# 6. AI & Market Intelligence APIs (Used by admin/ Studio)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSy..."
CINEPOINT_REFRESH_TOKEN="eyJhbGci..."
