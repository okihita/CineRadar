{
  "name": "cineradar-monorepo",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <=26.x",
    "pnpm": "^12.0.0"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "scripts": {
    "predev": "node scripts/check-ports.mjs 3000 3001",
    "predev:web": "node scripts/check-ports.mjs 3000",
    "predev:studio": "node scripts/check-ports.mjs 3001",
    "dev": "pnpm run dev:web & pnpm run dev:studio",
    "dev:web": "pnpm --filter=web dev --port 3000",
    "dev:studio": "pnpm --filter=studio dev --port 3001",
    "dev:admin": "pnpm run dev:studio",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "setup": "pnpm install && uv sync",
    "type-check": "pnpm -r type-check",
    "test:e2e": "kill -9 $(lsof -ti:3100) 2>/dev/null || true && kill -9 $(lsof -ti:3101) 2>/dev/null || true && playwright test",
    "test:e2e:ui": "kill -9 $(lsof -ti:3100) 2>/dev/null || true && kill -9 $(lsof -ti:3101) 2>/dev/null || true && playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "catalog:"
  }
}
