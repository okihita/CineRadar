#!/bin/sh
# CineRadar Git Pre-Commit Hook
# Validates backend linting and imports before committing

# Only run if python files in backend/ are staged
STAGED_BACKEND_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^backend/.*\.py$')

if [ -n "$STAGED_BACKEND_FILES" ]; then
    echo "🔍 Running Ruff linter on backend files..."
    uv run ruff check backend/
    RUFF_RESULT=$?
    if [ $RUFF_RESULT -ne 0 ]; then
        echo "❌ Ruff lint check failed! Please fix the errors above before committing."
        exit 1
    fi
    echo "✅ Ruff checks passed."

    echo "🔍 Running Mypy type checker on backend files..."
    uv run mypy backend/
    MYPY_RESULT=$?
    if [ $MYPY_RESULT -ne 0 ]; then
        echo "❌ Mypy type check failed! Please fix the errors above before committing."
        exit 1
    fi
    echo "✅ Mypy checks passed."
fi

exit 0
